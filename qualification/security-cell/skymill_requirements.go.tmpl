package main

import (
 "encoding/json"
 "fmt"
 "os"
 "github.com/xd-dash/skymill"
)

func main() {
 if len(os.Args)!=4 {panic("usage: skymill-requirements <scope> <stream> <output-json>")}
 req,err:=skymill.ScopedRedisRequirements(os.Args[1],os.Args[2])
 if err!=nil{panic(err)}
 if len(req.KeyPatterns)!=2 || len(req.Commands)==0{panic("incomplete scoped Skymill requirements")}
 out,err:=json.MarshalIndent(req,"","  ");if err!=nil{panic(err)}
 if err=os.WriteFile(os.Args[3],append(out,'\n'),0600);err!=nil{panic(err)}
 fmt.Println("compiled package-owned scoped Skymill Redis requirements")
}
